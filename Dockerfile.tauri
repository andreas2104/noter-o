# syntax=docker/dockerfile:1.7

FROM node:22-bookworm AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      curl \
      file \
      libappindicator3-dev \
      libayatana-appindicator3-dev \
      libfuse2 \
      libgtk-3-dev \
      librsvg2-dev \
      libwebkit2gtk-4.1-dev \
      patchelf \
      pkg-config \
      rpm \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain stable --profile minimal

WORKDIR /workspace

RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# The frontend is statically exported to /workspace/out by the Tauri hook.
RUN npm run tauri:build

FROM debian:bookworm-slim AS artifacts

RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /artifacts

COPY --from=builder /workspace/src-tauri/target/release/bundle/ /image-artifacts/

EXPOSE 3000
CMD ["sh", "-c", "cp -R /image-artifacts/. /artifacts/ && python3 -m http.server 3000 --directory /artifacts"]
